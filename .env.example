# LLM provider -- pick one and set the matching key
OPENAI_API_KEY=

# RentCast (property details + long-term rent estimate)
# Self-serve signup: https://www.rentcast.io/api
RENTCAST_API_KEY=

# AirROI (STR ADR / occupancy / revenue estimate)
# Self-serve signup: https://www.airroi.com/api -- $10 minimum credit deposit
AIRROI_API_KEY=

# Serper (web search, used by the Regulatory Analyst)
# Self-serve signup: https://serper.dev -- has a free tier
SERPER_API_KEY=
